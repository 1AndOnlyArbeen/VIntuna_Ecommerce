# Server
PORT=5000

# MongoDB connection string. DB name "backend" is appended automatically
# in src/db/index.js -> <MONGO_DB_URL>/backend
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_DB_URL=mongodb://localhost:27017

# Frontend origin (Vite dev server) - used for CORS and email verification links
FRONTEND_URL=http://localhost:5173

# JWT secrets - use long random strings
GENERATE_ACCESSTOKEN_KEY=your_access_token_secret
GENERATE_REFRESHTOKEN_KEY=your_refresh_token_secret

# Cloudinary - image uploads (https://cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend - transactional email API key (https://resend.com -> API Keys)
RESEND_API=re_your_api_key

# AI Chatbot - local Ollama (pull with: ollama pull llama3.1:8b)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1:8b
